# SMTP connection and credentials
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=true

# Message recipients (comma-separated values are supported)
EMAIL_FROM=your-email@gmail.com
EMAIL_TO=recipient@example.com
EMAIL_CC=manager@example.com,team@example.com

# Daily report
REPORT_ATTACHMENT=Reports/jay.pdf
REPORT_TIME=23:10
EMAIL_SUBJECT=Daily Report with Attachment
EMAIL_BODY=Hello, please find the daily report attached.

# Optional
EMAIL_TIMEOUT=30
EMAIL_LOG_FILE=email_scheduler.log
