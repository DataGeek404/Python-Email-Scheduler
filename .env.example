# Required SMTP credentials and recipients
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_TO=recipient@example.com

# SMTP transport: starttls (usually port 587), ssl (usually 465), or none
EMAIL_HOST=smtp.gmail.com
EMAIL_SECURITY=starttls
EMAIL_PORT=587
EMAIL_FROM=your-email@gmail.com
EMAIL_CC=manager@example.com,team@example.com
EMAIL_TIMEOUT=30
EMAIL_RETRIES=2
EMAIL_RETRY_BASE_SECONDS=2

# Report message and schedule
REPORT_ATTACHMENT=Reports/jay.pdf
REPORT_TIME=23:10
REPORT_TIMEZONE=Africa/Nairobi
EMAIL_SUBJECT=Daily Report with Attachment
EMAIL_BODY=Hello, please find the daily report attached.
EMAIL_MAX_ATTACHMENT_MB=18

# Worker operation and health
SCHEDULER_POLL_SECONDS=30
SCHEDULER_HEARTBEAT_SECONDS=60
EMAIL_STATUS_FILE=email_scheduler_status.json
EMAIL_HEALTH_MAX_AGE_SECONDS=300

# Logging. Set EMAIL_LOG_FILE=- for console-only container logs.
EMAIL_LOG_FILE=email_scheduler.log
EMAIL_LOG_LEVEL=INFO
EMAIL_LOG_MAX_MB=5
EMAIL_LOG_BACKUP_COUNT=3
EMAIL_LOG_CONSOLE=true

# Shared monitoring database and admin dashboard
# Omit MONITOR_DATABASE_URL locally to use scheduler_monitor.db.
MONITOR_DATABASE_URL=sqlite:///scheduler_monitor.db
MONITORING_ENABLED=true
MONITORING_REQUIRED=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_SECRET_KEY=replace-with-at-least-32-random-bytes
PORT=8000
